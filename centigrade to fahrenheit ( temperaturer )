#include <stdio.h>

int main() {
    float celsius, fahrenheit;

    printf("Enter temperature in Centigrade (Celsius): ");
    scanf("%f", &celsius);

    fahrenheit = (celsius * 9 / 5) + 32;

    printf("\n--- Temperature Conversion ---\n");
    printf("%.2f Celsius is equal to %.2f Fahrenheit\n", celsius, fahrenheit);

    return 0;
}
